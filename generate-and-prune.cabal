cabal-version:   3.0
name:            generate-and-prune
version:         0.1.0.0
synopsis:        Proof of concept: a generator of programs and the spec as a filter
license:         MIT
license-file:    LICENSE
author:          Federico Sawady
build-type:      Simple

common comun
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4.18 && <5

library
  import:          comun
  hs-source-dirs:  src
  exposed-modules: Naturals, Expr, Search
  build-depends:   QuickCheck >=2.14

executable demo
  import:          comun
  hs-source-dirs:  examples
  main-is:         Main.hs
  build-depends:   generate-and-prune

test-suite search
  import:          comun
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         CheckSearch.hs
  build-depends:   generate-and-prune, QuickCheck >=2.14
